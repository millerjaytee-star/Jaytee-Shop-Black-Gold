{
  "net_sales": {"formula":"gross_sales - discounts - comps - refunds","required_inputs":["gross_sales","discounts","comps","refunds"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "sales_growth_pct": {"formula":"(current_net_sales - prior_year_net_sales) / abs(prior_year_net_sales) * 100","required_inputs":["net_sales","prior_year_net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "average_check": {"formula":"net_sales / transactions","required_inputs":["net_sales","transactions"],"units":"USD/transaction","version":"STABILIS-METRIC-v0.1"},
  "labor_cost": {"formula":"hourly_labor_cost + management_labor_cost + overtime_cost","required_inputs":["hourly_labor_cost","management_labor_cost","overtime_cost"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "labor_pct": {"formula":"labor_cost / net_sales * 100","required_inputs":["labor_cost","net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "hourly_labor_pct": {"formula":"hourly_labor_cost / net_sales * 100","required_inputs":["hourly_labor_cost","net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "management_labor_pct": {"formula":"management_labor_cost / net_sales * 100","required_inputs":["management_labor_cost","net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "overtime_pct": {"formula":"overtime_cost / labor_cost * 100","required_inputs":["overtime_cost","labor_cost"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "sales_per_labor_hour": {"formula":"net_sales / labor_hours","required_inputs":["net_sales","labor_hours"],"units":"USD/hour","version":"STABILIS-METRIC-v0.1"},
  "labor_cost_per_transaction": {"formula":"labor_cost / transactions","required_inputs":["labor_cost","transactions"],"units":"USD/transaction","version":"STABILIS-METRIC-v0.1"},
  "cogs": {"formula":"food_purchases + beginning_inventory - ending_inventory + waste_cost","required_inputs":["food_purchases","beginning_inventory","ending_inventory","waste_cost"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "food_cost_pct": {"formula":"cogs / net_sales * 100","required_inputs":["cogs","net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "prime_cost": {"formula":"cogs + labor_cost","required_inputs":["cogs","labor_cost"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "prime_cost_pct": {"formula":"prime_cost / net_sales * 100","required_inputs":["prime_cost","net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "gross_margin": {"formula":"net_sales - cogs","required_inputs":["net_sales","cogs"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "location_contribution": {"formula":"net_sales - cogs - labor_cost - occupancy_cost - other_operating_cost","required_inputs":["net_sales","cogs","labor_cost","occupancy_cost","other_operating_cost"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "budget_variance_pct": {"formula":"(net_sales - budget_net_sales) / abs(budget_net_sales) * 100","required_inputs":["net_sales","budget_net_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "inventory_variance": {"formula":"book_inventory - physical_inventory","required_inputs":["book_inventory","physical_inventory"],"units":"USD","version":"STABILIS-METRIC-v0.1"},
  "waste_pct": {"formula":"waste_cost / cogs * 100","required_inputs":["waste_cost","cogs"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "discount_pct": {"formula":"discounts / gross_sales * 100","required_inputs":["discounts","gross_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "comp_pct": {"formula":"comps / gross_sales * 100","required_inputs":["comps","gross_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "refund_pct": {"formula":"refunds / gross_sales * 100","required_inputs":["refunds","gross_sales"],"units":"percent","version":"STABILIS-METRIC-v0.1"},
  "break_even_sales": {"formula":"fixed_costs / contribution_margin_ratio","required_inputs":["fixed_costs","contribution_margin_ratio"],"units":"USD","version":"STABILIS-METRIC-v0.1"}
}
